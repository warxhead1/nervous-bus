[Unit]
Description=nervous-bus host resource-pressure watchdog (disk, dir growth, restart storms)

[Service]
Type=oneshot
WorkingDirectory=%h/.cache/nervous-bus
ExecStart=/usr/bin/python3 %h/projects/nervous-bus/adapters/system-pressure/watch.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nervous-system-pressure
