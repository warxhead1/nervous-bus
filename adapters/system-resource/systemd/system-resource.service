[Unit]
Description=nervous-bus bounded Linux resource history collector

[Service]
Type=oneshot
WorkingDirectory=%h/.cache/nervous-bus
ExecStart=/usr/bin/python3 %h/projects/nervous-bus/adapters/system-resource/watch.py
Environment=NERVOUS_SOURCE=/system-resource
Environment=NERVOUS_STRICT_VALIDATION=1
Environment=NERVOUS_NO_ZELLIJ=1
Environment=TMPDIR=/tmp
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=%h/.cache/nervous-bus
CPUQuota=10%
MemoryMax=128M
IOWeight=20
TimeoutStartSec=30s
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nervous-system-resource
