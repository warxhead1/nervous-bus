[Unit]
Description=nervous-bus bounded Linux resource history collector

[Service]
Type=oneshot
WorkingDirectory=%h/.cache/nervous-bus
ExecStart=/usr/bin/python3 %h/projects/nervous-bus/adapters/system-resource/watch.py
Environment=NERVOUS_SYSTEM_RESOURCE_CGROUPS=user.slice
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=%h/.cache/nervous-bus/system-resource
CPUQuota=10%
MemoryMax=96M
IOWeight=100
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nervous-system-resource
