[Unit]
Description=nervous-bus codegraph-sync (debounced sync of opted-in codegraph indexes)

[Service]
Type=oneshot
# Batch work: build.slice is the box's batch slice (CPUWeight=30). The unit
# also carries its own low weight, nice and idle IO, so a sync never competes
# with a game, a stream or an interactive service.
Slice=build.slice
CPUWeight=10
IOWeight=10
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=15min
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/.cache/nervous-bus
# The code runs from a private clone of origin/main that the unit refreshes
# itself, so the shared checkout's branch, freeze or dirty tree never matters.
# A failed fetch (offline) keeps the last good clone.
Environment=SRC=%h/.local/share/nervous-bus/codegraph-sync-src
ExecStartPre=/bin/sh -c 'test -d "$SRC/.git" || git clone --quiet --depth 1 https://github.com/warxhead1/nervous-bus.git "$SRC"'
ExecStartPre=-/bin/sh -c 'git -C "$SRC" fetch --quiet --depth 1 origin main && git -C "$SRC" checkout --quiet --detach FETCH_HEAD'
ExecStart=/usr/bin/python3 ${SRC}/adapters/codegraph-sync/sync.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nervous-codegraph-sync
