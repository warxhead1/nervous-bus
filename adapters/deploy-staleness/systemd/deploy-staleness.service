[Unit]
Description=nervous-bus deploy-staleness monitor (watch the deploys, not just the code)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.cache/nervous-bus
ExecStart=%h/.pyenv/versions/3.11.13/bin/python3 %h/projects/nervous-bus/adapters/deploy-staleness/check.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nervous-deploy-staleness
ReadWritePaths=%h/.cache/nervous-bus
