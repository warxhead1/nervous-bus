{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "frontier-radar triage result",
  "type": "object",
  "required": ["claim", "why_it_matters", "domain", "kind", "durability", "action", "confidence"],
  "additionalProperties": false,
  "properties": {
    "claim": {"type": "string", "maxLength": 240, "description": "One sentence: what happened, stated as a fact from the item."},
    "why_it_matters": {"type": "string", "maxLength": 240, "description": "One sentence tied to a domain in the interest profile."},
    "domain": {"type": "string", "enum": ["harness", "memory", "research", "gamedev", "assets", "content", "ads", "markets", "models"]},
    "kind": {"type": "string", "enum": ["model", "tool", "technique", "skill", "paper", "benchmark", "deprecation", "security", "other"]},
    "durability": {"type": "string", "enum": ["durable", "decaying"]},
    "action": {"type": "string", "enum": ["adopt", "trial", "watch", "ignore"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
