#!/usr/bin/env python3
"""who-is-loading — which project is burning this host's CPU/memory, and who is wasting it.

  who-is-loading                 sample 3s, print top projects + flagged inefficiencies
  who-is-loading --json          same, machine-readable
  who-is-loading --record        sample and append to the bounded history (timer entry point)
  who-is-loading --record --emit  timer entry point: also publish finding transitions to the bus
  who-is-loading --html out.html [--hours 6]   render PSI + stacked per-project graphs from history
  who-is-loading --agents [--hours N]   per agent session (claude/codex/orca worktree) load and orphans
  who-is-loading --who TEXT      every process whose agent/project/command contains TEXT
  who-is-loading --tune [--hours N]   history distributions and the fire rate of each pressure threshold

CPU: NOW is the short sample window; AVG integrates every process (pid+starttime, children included)
over the whole gap since the previous --record run, and `coverage` is the share of host busy CPU that
the scan explained. Per-process read_bytes is disk reads, not swap; swap churn is attributed through
major faults and cgroup workingset_refault_anon.

Read-only: never signals, renices or reweights anything (game-priority-watch owns that).
"""
import argparse
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import hl_render  # noqa: E402
import hl_store  # noqa: E402


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--interval", type=float, default=3.0, help="sample window seconds")
    ap.add_argument("--top", type=int, default=8)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--record", action="store_true", help="append this sample to history")
    ap.add_argument("--html", metavar="PATH", help="write the graph page from history and exit")
    ap.add_argument("--hours", type=float, default=None, help="history window for --html / --agents (default 6)")
    ap.add_argument("--agents", action="store_true",
                    help="per-agent-session load (claude/codex/orca worktrees); with --hours N, from history")
    ap.add_argument("--who", metavar="TEXT", help="processes whose agent/project/command contains TEXT")
    ap.add_argument("--emit", action="store_true",
                    help="publish finding transitions to the bus (bus.host.load.finding.v1; critical also notifies)")
    ap.add_argument("--emit-dry-run", action="store_true", help="like --emit but print instead of publishing")
    ap.add_argument("--tune", action="store_true",
                    help="print recorded-history distributions and each pressure threshold's fire rate")
    ap.add_argument("--db", default=str(hl_store.DEFAULT_DB))
    ap.add_argument("--retention-days", type=int, default=7)
    args = ap.parse_args(argv)

    hours = args.hours or 6.0
    if args.tune:
        import hl_tune
        res = hl_tune.analyse(hl_tune.load(args.db, time.time() - args.hours * 3600 if args.hours else 0.0))
        print(json.dumps(res, indent=1) if args.json else hl_tune.render(res))
        return 0
    if args.html:
        h = hl_store.History(args.db)
        since = time.time() - hours * 3600
        page = hl_render.render_html(h.psi_series(since), h.project_series(since),
                                     h.recent_findings(since), hours)
        with open(args.html, "w") as fh:
            fh.write(page)
        print(args.html)
        return 0

    if args.agents and args.hours:
        rows = hl_store.History(args.db).agent_totals(time.time() - hours * 3600)
        print(hl_render.render_agent_history(rows))
        return 0
    hist = hl_store.History(args.db) if args.record else None
    s = hl_store.sample(interval=args.interval, prev=hist.load_snapshot() if hist else None)
    if hist:
        hist.record(s, args.retention_days)
    if args.emit or args.emit_dry_run:
        import hl_emit
        hl_emit.Emitter(dry_run=args.emit_dry_run).process(s["findings"], s["ts"])
    if args.agents:
        print(json.dumps(s["agents"], indent=1, default=str) if args.json else hl_render.render_agents(s["agents"], 30))
        return 0
    if args.who:
        print(hl_render.render_who(s, args.who))
        return 0
    if args.json:
        json.dump(hl_store.public(s), sys.stdout, indent=1, default=str)
        print()
    else:
        print(hl_render.render_text(s, args.top))
    return 0


if __name__ == "__main__":
    sys.exit(main())
