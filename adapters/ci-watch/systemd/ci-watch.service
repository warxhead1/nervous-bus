[Unit]
Description=nervous-bus CI/CD pipeline observability + contract lint (ci-watch)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.cache/nervous-bus
ExecStart=%h/.pyenv/versions/3.11.13/bin/python3 %h/projects/nervous-bus/adapters/ci-watch/watch.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nervous-ci-watch
ReadWritePaths=%h/.cache/nervous-bus
