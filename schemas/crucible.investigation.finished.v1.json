{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nervous-bus/schemas/crucible.investigation.finished.v1.json",
  "title": "crucible.investigation.finished v1",
  "description": "An investigation produced a verdict. Ids, enums, counts and timings only: no question or label text rides the bus. A consumer that needs text reads the ledger.",
  "type": "object",
  "required": [
    "game",
    "investigation_id",
    "reading",
    "verdict",
    "n",
    "controls_ok",
    "wall_s",
    "model_requests"
  ],
  "properties": {
    "game": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "investigation_id": {
      "type": "string",
      "pattern": "^x-[0-9A-HJKMNP-TV-Z]{26}(\\.[0-9]+)?$"
    },
    "reading": {
      "type": "string",
      "enum": [
        "formal",
        "open"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "balanced",
        "unbalanced"
      ]
    },
    "n": {
      "type": "integer",
      "minimum": 0
    },
    "controls_ok": {
      "type": "boolean"
    },
    "wall_s": {
      "type": "number",
      "minimum": 0
    },
    "model_requests": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
