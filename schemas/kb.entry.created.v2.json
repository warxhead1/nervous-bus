{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb.entry.created.v2",
  "title": "KB Entry Created v2",
  "description": "PLANNED migration contract for normalized KB entry-created events. No producer emits and no consumer accepts v2 yet; the companion KB migration must dual-publish or cut consumers over only after it supplies every required identity, category, provenance, confidence basis, and timestamp field. v1 remains live and unchanged during that migration window.",
  "status": "planned-unconsumed-unproduced",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry_id",
    "title",
    "project",
    "category",
    "source_type",
    "provenance",
    "confidence",
    "occurred_at",
    "file"
  ],
  "properties": {
    "entry_id": {
      "type": "string",
      "format": "uuid",
      "description": "Canonical UUID of the created vault entry; legacy id is not accepted."
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "project": { "type": "string", "minLength": 1, "maxLength": 200 },
    "category": {
      "type": "string",
      "enum": ["research", "design", "handoff", "plan", "reference", "log", "concept", "decision"],
      "description": "Canonical Category wire form from kb/src/frontmatter/parser.rs."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "manual",
        "agent-generated",
        "deer-flow-research",
        "deer-flow-guidance",
        "tengine-session",
        "tengine-planning",
        "test-result",
        "bead-outcome",
        "bus-event",
        "codemap-derived"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "source_kind", "source_uri"],
      "properties": {
        "producer": {
          "type": "string",
          "enum": [
            "kb.ingest",
            "kb.graphify",
            "kb.watch.deer-flow-authored",
            "kb.watch.application-submitted",
            "kb.entry.create",
            "kb.landmark"
          ]
        },
        "source_kind": {
          "type": "string",
          "enum": ["human-authored", "agent-authored", "bus-event", "derived"]
        },
        "source_uri": { "type": "string", "format": "uri", "minLength": 1 }
      }
    },
    "confidence": {
      "description": "Confidence is never an unexplained scalar. Each branch identifies whether the value was measured, inferred, or a producer default.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "basis", "evidence_uri", "method"],
          "properties": {
            "value": { "type": "number", "minimum": 0, "maximum": 1 },
            "basis": { "const": "measured" },
            "evidence_uri": { "type": "string", "format": "uri", "minLength": 1 },
            "method": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "basis", "evidence_uri", "rationale"],
          "properties": {
            "value": { "type": "number", "minimum": 0, "maximum": 1 },
            "basis": { "const": "inferred" },
            "evidence_uri": { "type": "string", "format": "uri", "minLength": 1 },
            "rationale": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "basis", "default_policy"],
          "properties": {
            "value": { "type": "number", "minimum": 0, "maximum": 1 },
            "basis": { "const": "default" },
            "default_policy": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        }
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "file": { "type": "string", "minLength": 1, "description": "Absolute path to the written vault markdown entry." },
    "trace_uri": { "type": "string", "format": "uri", "minLength": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 100 },
      "uniqueItems": true,
      "maxItems": 20
    },
    "content_hash": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
  }
}
