{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nervous-bus/schemas/bus.hearth.decision.responded.v1.json",
  "title": "bus.hearth.decision.responded v1",
  "description": "A decision was settled. Published on every settlement: answered, defaulted, withdrawn, or expired. Every surface drops the card when this event arrives for its decision_id.",
  "type": "object",
  "required": [
    "decision_id",
    "status",
    "responded_at"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string"
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "choice",
        "errand",
        "question",
        "permission"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "answered",
        "defaulted",
        "withdrawn",
        "expired"
      ]
    },
    "option_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "answers": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "done": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "via": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "kiln",
        "kiln-android",
        "hearth-web",
        "hearth-android",
        "watch",
        "slack",
        "terminal",
        "push",
        "chat",
        null
      ]
    },
    "answered_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "responded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
