{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nervous-bus/schemas/bus.hearth.decision.requested.v1.json",
  "title": "bus.hearth.decision.requested v1",
  "description": "An agent needs the owner's call. Emitted by hearth on create and on upsert of an agent_decisions row. Supports choice, errand, question, and permission kinds. Carries either options or parts, never both.",
  "type": "object",
  "required": [
    "decision_id",
    "correlation_id",
    "project",
    "title"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "correlation_id": {
      "type": "string",
      "description": "Equals decision_id; clears the card"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "type": "string",
      "enum": [
        "choice",
        "errand",
        "question",
        "permission"
      ],
      "default": "choice"
    },
    "relay_mode": {
      "type": "string",
      "enum": [
        "session_text",
        "orca_ask_driver",
        "permission_keystroke",
        "none"
      ],
      "default": "session_text"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "say": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 140,
      "description": "Spoken one-line form of the title for voice and watch"
    },
    "context": {
      "type": "string"
    },
    "media": {
      "type": "array",
      "maxItems": 8,
      "default": [],
      "description": "Decision-level media URIs shown above options and parts",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^(hearth-media://[0-9a-fA-F]{64}|https://\\S+)$"
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "say": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 140
          }
        },
        "additionalProperties": true
      },
      "maxItems": 6
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "say": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 140
          },
          "recommended": {
            "type": [
              "string",
              "null"
            ]
          },
          "multi_select": {
            "type": "boolean",
            "default": false
          },
          "media": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "say": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 140
                }
              },
              "additionalProperties": true
            },
            "maxItems": 6
          }
        },
        "additionalProperties": true
      },
      "maxItems": 8
    },
    "recommended": {
      "type": [
        "string",
        "null"
      ]
    },
    "default_after": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "links": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 20
    },
    "audience": {
      "type": "string",
      "enum": [
        "owner",
        "members",
        "all"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "answered",
        "defaulted",
        "withdrawn",
        "expired"
      ]
    },
    "metadata": {
      "type": "object",
      "description": "Producer data (at most 4 KB) that surfaces may read but must never require"
    },
    "viewer_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "not": {
    "required": [
      "options",
      "parts"
    ],
    "properties": {
      "options": {
        "minItems": 1
      },
      "parts": {
        "minItems": 1
      }
    }
  },
  "if": {
    "required": [
      "kind"
    ],
    "properties": {
      "kind": {
        "const": "errand"
      }
    }
  },
  "then": {
    "properties": {
      "options": {
        "maxItems": 0
      },
      "parts": {
        "maxItems": 0
      }
    }
  },
  "additionalProperties": true
}
