{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nervous-bus/schemas/bus.hearth.decision.requested.v1.json",
  "title": "bus.hearth.decision.requested v1",
  "description": "An agent needs the owner's call. Emitted by hearth on create and on upsert of an agent_decisions row. Supports choice, errand, question, and permission kinds. Carries either options or parts, never both.",
  "type": "object",
  "required": [
    "decision_id",
    "correlation_id",
    "project",
    "title"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "correlation_id": {
      "type": "string",
      "description": "Equals decision_id; clears the card"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "type": "string",
      "enum": [
        "choice",
        "errand",
        "question",
        "permission"
      ],
      "default": "choice"
    },
    "relay_mode": {
      "type": "string",
      "enum": [
        "session_text",
        "orca_ask_driver",
        "permission_keystroke",
        "none"
      ],
      "default": "session_text"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "say": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 140,
      "description": "Spoken one-line form of the title for voice and watch"
    },
    "context": {
      "type": "string"
    },
    "media": {
      "type": "array",
      "maxItems": 8,
      "default": [],
      "description": "Decision-level media shown above options and parts: v1 string refs or v2 media objects",
      "items": {
        "$ref": "#/$defs/mediaEntry"
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "say": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 140
          },
          "media": {
            "$ref": "#/$defs/optionMedia"
          }
        },
        "additionalProperties": true
      },
      "maxItems": 6
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "say": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 140
          },
          "recommended": {
            "type": [
              "string",
              "null"
            ]
          },
          "multi_select": {
            "type": "boolean",
            "default": false
          },
          "media": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "$ref": "#/$defs/partMediaEntry"
            }
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "say": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 140
                },
                "media": {
                  "$ref": "#/$defs/optionMedia"
                }
              },
              "additionalProperties": true
            },
            "maxItems": 6
          }
        },
        "additionalProperties": true
      },
      "maxItems": 8
    },
    "recommended": {
      "type": [
        "string",
        "null"
      ]
    },
    "default_after": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "links": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 20
    },
    "audience": {
      "type": "string",
      "enum": [
        "owner",
        "members",
        "all"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "answered",
        "defaulted",
        "withdrawn",
        "expired"
      ]
    },
    "metadata": {
      "type": "object",
      "description": "Producer data (at most 4 KB) that surfaces may read but must never require"
    },
    "viewer_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "input": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "maxItems": 4,
      "description": "Answer modes beyond a one-tap pick (decision media v2)",
      "items": {
        "enum": [
          "pins",
          "rank",
          "notes",
          "changes"
        ]
      }
    }
  },
  "not": {
    "required": [
      "options",
      "parts"
    ],
    "properties": {
      "options": {
        "minItems": 1
      },
      "parts": {
        "minItems": 1
      }
    }
  },
  "if": {
    "required": [
      "kind"
    ],
    "properties": {
      "kind": {
        "const": "errand"
      }
    }
  },
  "then": {
    "properties": {
      "options": {
        "maxItems": 0
      },
      "parts": {
        "maxItems": 0
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "mediaRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^hearth-media://[0-9a-f]{64}$"
    },
    "mediaObject": {
      "type": "object",
      "description": "A typed media object (decision media v2). Every ref is a hearth-media:// digest already in Hearth's store; nothing is fetched remotely.",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "image",
            "video",
            "model",
            "sequence",
            "compare"
          ]
        },
        "src": {
          "$ref": "#/$defs/mediaRef"
        },
        "poster": {
          "$ref": "#/$defs/mediaRef"
        },
        "frames": {
          "type": "array",
          "minItems": 2,
          "maxItems": 72,
          "items": {
            "$ref": "#/$defs/mediaRef"
          }
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "src"
            ],
            "properties": {
              "src": {
                "$ref": "#/$defs/mediaRef"
              },
              "label": {
                "type": "string",
                "maxLength": 40
              }
            },
            "additionalProperties": false
          }
        },
        "label": {
          "type": "string",
          "maxLength": 80
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "image"
              }
            }
          },
          "then": {
            "required": [
              "src"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "video"
              }
            }
          },
          "then": {
            "required": [
              "src"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "model"
              }
            }
          },
          "then": {
            "required": [
              "src",
              "poster"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sequence"
              }
            }
          },
          "then": {
            "required": [
              "frames"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "compare"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        }
      ]
    },
    "mediaEntry": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(hearth-media://[0-9a-f]{64}|https://\\S+)$"
        },
        {
          "$ref": "#/$defs/mediaObject"
        }
      ]
    },
    "partMediaEntry": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "$ref": "#/$defs/mediaObject"
        }
      ]
    },
    "optionMedia": {
      "type": "array",
      "maxItems": 4,
      "default": [],
      "description": "Media that is this option; a client shows the option as one tappable tile",
      "items": {
        "$ref": "#/$defs/mediaEntry"
      }
    }
  }
}
