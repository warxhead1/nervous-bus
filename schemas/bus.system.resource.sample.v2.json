{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nervous-bus/schemas/bus.system.resource.sample.v2.json",
  "title": "Bounded Linux resource measurement batch v2",
  "description": "One host and at most eight cgroups. Local durability and bus acknowledgement are separate. Findings describe observed pressure, not causes. V1 remains available for compatibility.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "ts": {
      "type": "number",
      "minimum": 0
    },
    "monotonic_s": {
      "type": "number",
      "minimum": 0
    },
    "boot_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "2.0.0"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "config_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "version",
        "digest",
        "config_digest"
      ]
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 27,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collection_ms": {
          "type": "number",
          "minimum": 0
        },
        "collector_cpu_ms": {
          "type": "number",
          "minimum": 0
        },
        "entities": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "unavailable_entities": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "warnings": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "required": [
        "collection_ms",
        "collector_cpu_ms",
        "entities",
        "unavailable_entities",
        "warnings"
      ]
    }
  },
  "required": [
    "id",
    "host",
    "ts",
    "monotonic_s",
    "boot_id",
    "collector",
    "entities",
    "findings",
    "health"
  ],
  "$defs": {
    "nullable": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "psi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "avg10": {
          "$ref": "#/$defs/nullable"
        },
        "avg60": {
          "$ref": "#/$defs/nullable"
        },
        "avg300": {
          "$ref": "#/$defs/nullable"
        },
        "total_usec": {
          "$ref": "#/$defs/nullable"
        }
      },
      "required": [
        "avg10",
        "avg60",
        "avg300",
        "total_usec"
      ]
    },
    "pressure": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "some": {
              "$ref": "#/$defs/psi"
            },
            "full": {
              "$ref": "#/$defs/psi"
            }
          },
          "required": [
            "some"
          ]
        }
      ]
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "limited",
            "unlimited",
            "unavailable"
          ]
        },
        "value": {
          "$ref": "#/$defs/nullable"
        }
      },
      "required": [
        "state",
        "value"
      ]
    },
    "device": {
      "type": "object",
      "required": [
        "name",
        "read_bytes",
        "write_bytes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind": {
          "enum": [
            "host",
            "cgroup"
          ]
        },
        "identity": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "device_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "state": {
          "enum": [
            "ok",
            "partial",
            "unavailable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "counters": {
          "type": "object",
          "maxProperties": 24,
          "additionalProperties": {
            "$ref": "#/$defs/nullable"
          }
        },
        "gauges": {
          "type": "object",
          "maxProperties": 24,
          "additionalProperties": {
            "$ref": "#/$defs/nullable"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "$ref": "#/$defs/limit"
            },
            "memory_high": {
              "$ref": "#/$defs/limit"
            },
            "memory_max": {
              "$ref": "#/$defs/limit"
            }
          },
          "required": []
        },
        "pressure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "$ref": "#/$defs/pressure"
            },
            "memory": {
              "$ref": "#/$defs/pressure"
            },
            "io": {
              "$ref": "#/$defs/pressure"
            }
          },
          "required": [
            "cpu",
            "memory",
            "io"
          ]
        },
        "devices": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/device"
          }
        },
        "interval": {
          "$ref": "#/$defs/interval"
        }
      },
      "required": [
        "entity",
        "kind",
        "identity",
        "device_identity",
        "state",
        "reason",
        "counters",
        "gauges",
        "limits",
        "pressure",
        "devices",
        "interval"
      ]
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "ok",
            "unavailable",
            "reset"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "elapsed_s": {
          "$ref": "#/$defs/nullable"
        },
        "deltas": {
          "type": "object",
          "maxProperties": 24,
          "additionalProperties": {
            "$ref": "#/$defs/nullable"
          }
        },
        "rates": {
          "type": "object",
          "maxProperties": 24,
          "additionalProperties": {
            "$ref": "#/$defs/nullable"
          }
        }
      },
      "required": [
        "state",
        "reason",
        "elapsed_s",
        "deltas",
        "rates"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "elapsed_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "elapsed_s": {
                "type": "null"
              },
              "deltas": {
                "maxProperties": 0
              },
              "rates": {
                "maxProperties": 0
              }
            }
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "entity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "resource": {
          "enum": [
            "cpu",
            "memory",
            "io"
          ]
        },
        "threshold_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "observed_pct": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "from_ts": {
          "type": "number",
          "minimum": 0
        },
        "to_ts": {
          "type": "number",
          "minimum": 0
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "cooldown_s": {
          "type": "integer",
          "minimum": 60
        },
        "interpretation": {
          "const": "sustained observed pressure; cause unproven"
        }
      },
      "required": [
        "key",
        "entity",
        "resource",
        "threshold_pct",
        "observed_pct",
        "from_ts",
        "to_ts",
        "duration_s",
        "cooldown_s",
        "interpretation"
      ]
    }
  }
}
