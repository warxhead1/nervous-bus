{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nervous-bus/schemas/crucible.sitting.closed.v1.json",
  "title": "crucible.sitting.closed v1",
  "description": "A sitting ended. Ids, enums, counts and timings only: no question or label text rides the bus. A consumer that needs text reads the ledger.",
  "type": "object",
  "required": [
    "game",
    "sitting_id",
    "cards",
    "taps",
    "seconds",
    "pushes"
  ],
  "properties": {
    "game": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "sitting_id": {
      "type": "string",
      "pattern": "^sit-[0-9A-HJKMNP-TV-Z]{26}(\\.[0-9]+)?$"
    },
    "cards": {
      "type": "integer",
      "minimum": 0
    },
    "taps": {
      "type": "integer",
      "minimum": 0
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "pushes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
