[Unit]
Description=Maintenance train — nightly select+dispatch+finalize across the beads_global maintenance queue
Documentation=file:/home/eric/projects/nervous-bus/tools/maintenance-train/README.md

[Service]
Type=oneshot
# pyenv shims first: selector.py needs pymysql, which lives in the pyenv
# 3.11 site-packages — the bare systemd PATH resolves python3 to /usr/bin
# (no pymysql) and the whole train dies at select (bit 2026-08-31 05:01).
Environment=PATH=/home/eric/.pyenv/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/eric/projects/nervous-bus/tools/maintenance-train/run-nightly.sh
TimeoutStartSec=21600
Nice=10
IOSchedulingClass=idle
# Not enabled by delivery; Eric enables explicitly:
#   systemctl --user enable --now maintenance-train.timer
