def rel(p):
    return Path(p).relative_to(ROOT).as_posix()


def url(path):
    return RAW + path


def ruling_text(name):
    """Plain markdown rule text, built from the plugin's cues when it has no ruling file."""
    cues = json.loads((ST / name / "hooks" / "cues.json").read_text())
    seen, out = set(), []
    for c in cues:
        t = re.sub(r"^\[[^\]]+\]\s*", "", c["say"])
        t = re.sub(r"\s*Load the [\w-]+ skill\.?\s*$", "", t).strip()
        if t not in seen:
            seen.add(t)
            out.append(t)
    return f"# {name}\n\n" + "\n\n".join(out) + "\n"


def skill_files(name, skill):
    d = ST / name / "skills" / skill
    return sorted(rel(p) for p in d.rglob("*") if p.is_file() and "__pycache__" not in p.parts and not p.name.endswith(".pyc"))


def plugin_hooks(name):
    """(script basename, event, matcher, timeout) from the plugin's own hooks.json."""
    path = ST / name / "hooks" / "hooks.json"
    if not path.is_file():
        return []
    data = json.loads(path.read_text())["hooks"]
    out = []
    for event, groups in data.items():
        for g in groups:
            for h in g["hooks"]:
                m = re.search(r'/((?:hooks|skills|bin)/[^"\s]+)"?$', h["command"].strip()) or re.search(r'/((?:hooks|skills|bin)/\S+)', h["command"])
                if m and not h["command"].startswith("cat "):
                    out.append((m.group(1), event, g.get("matcher"), h.get("timeout", 10)))
    return out


EVENT_MAP = {"codex": {}, "kiro": {}, "claude-code": {},
             "gemini": {"PreToolUse": "BeforeTool", "PostToolUse": "AfterTool", "UserPromptSubmit": "BeforeAgent", "Stop": "AfterAgent"},
             "omp": {"PreToolUse": "tool_call", "PostToolUse": "tool_result"}}
