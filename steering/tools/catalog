    "codex": {"Bash": "Bash", "Write|Edit|MultiEdit": "apply_patch", "Agent|Task": "spawn_agent"},
    "gemini": {"Bash": "run_shell_command", "Write|Edit|MultiEdit": "write_file|replace"},
    "kiro": {"Bash": "shell", "Write|Edit|MultiEdit": "write", "Agent|Task": "subagent"},
    "omp": {"Bash": "bash", "Write|Edit|MultiEdit": "edit|write"},
    "claude-code": {"Bash": "Bash", "Write|Edit|MultiEdit": "Write|Edit|MultiEdit", "Agent|Task": "Agent|Task"},
}
HOME = "$STEERING_HOME"


def command_for(harness, name, script, event):
    target = f'"{HOME}/{name}/{script}"'
    if harness == "claude-code":
        return f"python3 {target}"
    return f'python3 "{HOME}/adapters/shim" --harness {harness} --event {event} {target}'


def adapter_files():
    """{path: text} of one hook config per harness per plugin, from the plugin's own hooks.json."""
    out = {}
    for name in ORDER:
        hooks = plugin_hooks(name)
        for harness in ("claude-code", "codex", "gemini", "kiro", "omp"):
            rows = []
            for script, event, matcher, timeout in hooks:
                ev = EVENT_MAP[harness].get(event, event) if harness != "omp" else EVENT_MAP["omp"].get(event)
                if ev is None:
                    continue
                if matcher is not None:
                    mt = MATCH_MAP[harness].get(matcher)
                    if mt is None:
                        continue
                else:
                    mt = None
                rows.append((script, event, ev, mt, timeout))
            if not rows:
                continue
            if harness in ("claude-code", "codex", "gemini"):
                cfg = {}
                for script, event, ev, mt, timeout in rows:
                    g = {"hooks": [{"type": "command", "command": command_for(harness, name, script, event), "timeout": timeout}]}
                    if mt:
                        g["matcher"] = mt
                    cfg.setdefault(ev, []).append(g)
                path = {"claude-code": f"steering/adapters/claude-code/{name}.settings.json",
                        "codex": f"steering/adapters/codex/{name}.hooks.json",
                        "gemini": f"steering/adapters/gemini/{name}.settings.json"}[harness]
                out[path] = json.dumps({"hooks": cfg}, indent=2) + "\n"
            elif harness == "kiro":
                hs = []
                for script, event, ev, mt, timeout in rows:
                    h = {"name": f"{name}-{Path(script).name}-{event}", "trigger": ev, "action": {"type": "command", "command": command_for(harness, name, script, event)},
                         "timeout": timeout, "enabled": True}
                    if mt:
                        h["matcher"] = mt
                    hs.append(h)
                out[f"steering/adapters/kiro/{name}.json"] = json.dumps({"version": "v1", "hooks": hs}, indent=2) + "\n"
            else:
                for kind, handler in (("pre", "tool_call"), ("post", "tool_result")):
                    mine = [r for r in rows if r[2] == handler]
                    if not mine:
                        continue
                    calls = ",\n".join(
                        f'  ["{mt or ".*"}", "{HOME}/{name}/{script}", "{event}"]' for script, event, ev, mt, timeout in mine)
                    block = '{ block: true, reason: r.stderr }' if kind == 'pre' else '{ additionalContext: r.stderr }'
                    ts = OMP_TS.format(handler=handler, calls=calls, kind=kind, block=block)
                    out[f"steering/adapters/omp/{name}.{kind}.ts"] = ts
    return out


OMP_TS = """// oh-my-pi {kind} hook for a steering plugin. Put it in .omp/hooks/{kind}/ (project) or ~/.omp/agent/hooks/{kind}/.
// Runs each check through adapters/shim and turns exit code 2 into a block (pre) or extra context (post).
// Set STEERING_HOME to the folder that holds adapters/ and one folder per plugin.
import {{ spawnSync }} from "node:child_process";

const checks: [string, string, string][] = [
{calls}
];
const home = process.env.STEERING_HOME ?? "";

export default function (pi: any): void {{
  pi.on("{handler}", async (event: any) => {{
    for (const [pattern, script, hookEvent] of checks) {{
      if (!new RegExp("^(" + pattern + ")$").test(event.toolName)) continue;
      const r = spawnSync("python3", [home + "/adapters/shim", "--harness", "omp", "--event", hookEvent, script.replace("$STEERING_HOME", home)], {{
        input: JSON.stringify({{ hook_event_name: "{handler}", toolName: event.toolName, input: event.input }}),
        encoding: "utf8",
      }});
      if (r.status === 2) return {block};
    }}
  }});
}}
"""


def adapter_pieces(files):
    out = [{"id": "adapter/shim", "kind": "adapter", "plugin": None, "path": "steering/adapters/shim",
            "purpose": "Translate a Codex, Gemini CLI, Kiro CLI or oh-my-pi hook event to the Claude Code event the checks read, and run a check.",
            "requires": [],
            "smoke": {"steps": [{"args": ["--help"], "exit": 0, "stdout_contains": "harness"}]}}]
    for key, label, p in HARNESSES:
        out.append({"id": f"adapter/{key}", "kind": "adapter", "plugin": None, "path": "steering/" + p,
                    "purpose": f"How to wire the rulings, skills and checks into {label}, with the hook events, input shapes and what can block.", "requires": []})
    for path in sorted(files):
        parts = Path(path).parts
        harness, fname = parts[2], parts[3]
        plugin = fname.split(".")[0]
        out.append({"id": f"adapter/{harness}/{plugin}" + (f"/{fname.split('.')[1]}" if harness == "omp" else ""), "kind": "adapter",
                    "plugin": plugin, "path": path,
                    "purpose": f"Hook config that runs the {plugin} checks in {dict((k, l) for k, l, _ in HARNESSES)[harness]}.",
                    "requires": ["steering/adapters/shim"] if harness != "claude-code" else []})
    return out


def build():
    rulings, pieces = {}, []
    for name in ORDER:
        m = META[name]
        if m.get("ruling") is None and name != "ub-mode":
            pass
        if m.get("authored"):
            rpath = m["authored"]
        elif m.get("ruling"):
            rpath = f"steering/{name}/{m['ruling']}"
        elif name == "ub-mode":
            rpath = None
        else:
            rpath = f"steering/rulings/{name}.md"
            rulings[rpath] = ruling_text(name)
        if name == "ub-mode":
            rpath = "steering/rulings/ub-mode.md"
            rulings[rpath] = ruling_text(name)
        pieces.append({"id": f"{name}/ruling", "kind": "ruling", "plugin": name, "path": rpath,
                       "purpose": m["purpose"] + " Plain markdown to paste into AGENTS.md, GEMINI.md, a Kiro steering file or a system prompt.",
                       "requires": []})
        files = skill_files(name, m["skill"])
        pieces.append({"id": f"{name}/skill", "kind": "skill", "plugin": name, "path": f"steering/{name}/skills/{m['skill']}",
                       "entry": f"steering/{name}/skills/{m['skill']}/SKILL.md", "files": files,
                       "purpose": f"The `{m['skill']}` method as an Agent Skills folder (SKILL.md and its references).", "requires": []})
        has_cue = (ST / name / "hooks" / "cue").is_file()
        cue = has_cue and {"name": "cue", "path": "hooks/cue", "purpose": "Say the rule when the prompt calls for it.", "effect": "context",
               "event": "UserPromptSubmit", "matcher": None, "kill_switch": "STEERING_CUES_DISABLE=1",
               "input": "One JSON object on stdin with `prompt`. Prints the rule on stdout when the prompt matches `cues.json`, nothing otherwise. Always exits 0.",
               "requires": ["hooks/cues.json"],
               "smoke": {"steps": [{"stdin": {"prompt": json.loads((ST / name / "evals" / "trigger.json").read_text())["should"][0]}, "exit": 0, "stdout_contains": f"[{name}]"}]}}
        for c in m["checks"] + ([cue] if has_cue else []):
            pieces.append({"id": f"{name}/check/{c['name']}", "kind": "check", "plugin": name, "path": f"steering/{name}/{c['path']}",
                           "purpose": c["purpose"], "effect": c["effect"], "event": c["event"], "matcher": c["matcher"],
                           "kill_switch": c["kill_switch"], "input": c["input"],
                           "requires": [f"steering/{name}/{r}" for r in c["requires"]], "smoke": c["smoke"]})
    afiles = adapter_files()
    pieces += adapter_pieces(afiles)
    for p in pieces:
        p["url"] = url(p["path"])
        if "files" in p:
            p["file_urls"] = [url(f) for f in p["files"]]
        if p["requires"]:
            p["require_urls"] = [url(r) for r in p["requires"]]
    cat = {"repo": REPO, "ref": "main", "raw_base": RAW,
           "about": "Each piece stands alone: fetch its `url` (and `require_urls`, kept at the same relative layout) and use it. Checks are Python 3 scripts that use only the standard library.",
           "pieces": pieces}
    return cat, rulings, afiles


def llms(cat):
    lines = ["# steering", "",
             "> Rulings for coding agents, each with the check that enforces it. Every piece below is fetchable on its own by raw URL. Machine-readable list: " + url("steering/catalog.json"), ""]
    for kind, title in (("ruling", "Rulings (plain markdown, paste into AGENTS.md, GEMINI.md, a steering file or a system prompt)"),
                        ("skill", "Skills (Agent Skills folders; fetch SKILL.md, then the other files listed)"),
                        ("check", "Checks (Python 3 scripts; JSON on stdin, exit 2 blocks or reports)"),
                        ("adapter", "Adapters (per-harness wiring)")):
        lines += [f"## {title}", ""]
        for p in cat["pieces"]:
            if p["kind"] != kind:
                continue
            tgt = p.get("entry") and url(p["entry"]) or p["url"]
            dep = f" Needs: {', '.join(p['require_urls'])}." if p.get("require_urls") else ""
            lines.append(f"- [{p['id']}]({tgt}): {p['purpose']}{dep}")
            for fu in (p.get("file_urls") or []):
                if fu != tgt:
                    lines.append(f"  - {fu}")
        lines.append("")
    return "\n".join(lines)


START, END = "<!-- catalog:start -->", "<!-- catalog:end -->"


def block(cat, name, rulings):
    ps = [p for p in cat["pieces"] if p["plugin"] == name]
    ruling = next(p for p in ps if p["kind"] == "ruling")
    skill = next(p for p in ps if p["kind"] == "skill")
    text = (rulings.get(ruling["path"]) or (ROOT / ruling["path"]).read_text()).strip()
    quoted = "\n".join(("> " + l).rstrip() for l in text.splitlines())
    out = [START, "## Use it in any agent", "",
           "Each piece below works alone. Nothing here needs Claude Code, and nothing needs the rest of this repository.", "",
           f"**The rule.** Paste this into `AGENTS.md`, `GEMINI.md`, a Kiro steering file or any system prompt. File: [{Path(ruling['path']).name}]({ruling['url']}).", "",
           quoted, "",
           f"**The skill.** An [Agent Skills](https://agentskills.io) folder: [`SKILL.md`]({url(skill['entry'])})"
           + (f" with {len(skill['files']) - 1} more file(s) listed in [catalog.json](../catalog.json)." if len(skill["files"]) > 1 else "."), "",
           "**The checks.** Plain Python 3 scripts with no dependencies.", "",
           "| check | what it takes | effect | event and matcher | off |", "|---|---|---|---|---|"]
    for p in ps:
        if p["kind"] != "check":
            continue
        ev = ((p["event"] or "run by hand") + (f" on {p['matcher']}" if p["matcher"] else "")).replace("|", "\\|")
        needs = f" Keep with it: {', '.join('`' + Path(r).name + '`' for r in p['requires'])}." if p["requires"] else ""
        off = f"`{p['kill_switch']}`" if p["kill_switch"] else ""
        out.append(f"| [`{Path(p['path']).name}`]({p['url']}) | {p['input']}{needs} | {p['effect']} | {ev} | {off} |")
    cfgs = [q for q in cat["pieces"] if q["kind"] == "adapter" and q["plugin"] == name]
    names = []
    for q in cfgs:
        parts = q["id"].split("/")
        names.append(f"[{parts[1]}{'/' + parts[3] if len(parts) == 4 else ''}]({q['url']})")
    out += ["", "**Ready-made hook config** (set `STEERING_HOME`, see the harness page): " + ", ".join(names) + ".",
            "", "Wiring, hook events, input shapes and what each hook can block: "
            + ", ".join(f"[{label}](../{path})" for _, label, path in HARNESSES) + ".", END]
    return "\n".join(out)


def readme_with(cat, name, rulings):
    p = ST / name / "README.md"
    s = p.read_text()
    b = block(cat, name, rulings)
    if START in s:
        return re.sub(re.escape(START) + r".*?" + re.escape(END), lambda _: b, s, flags=re.S)
    i = s.index("## Install")
    return s[:i] + b + "\n\n" + s[i:]


def main(argv):
    cat, rulings, afiles = build()
    rulings = {**rulings, **afiles}
    outputs = {ST / "catalog.json": json.dumps(cat, indent=2) + "\n", ST / "llms.txt": llms(cat) + "\n"}
    for path, text in rulings.items():
        outputs[ROOT / path] = text
    for name in ORDER:
        if (ST / name / "README.md").is_file():
            outputs[ST / name / "README.md"] = readme_with(cat, name, rulings)
    stale = [rel(p) for p, t in outputs.items() if not p.exists() or p.read_text() != t]
    if "--check" in argv:
        if stale:
            print("out of date: " + ", ".join(stale), file=sys.stderr)
            return 1
        return 0
    for p, t in outputs.items():
        p.parent.mkdir(parents=True, exist_ok=True)
        with open(p, "w", encoding="utf-8", newline="\n") as f:
            f.write(t)
    print(f"wrote {len(outputs)} files, {len(cat['pieces'])} pieces")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
