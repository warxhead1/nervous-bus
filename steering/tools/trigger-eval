#!/usr/bin/env python3
"""Measure how often each steering skill is loaded for the prompts it should catch.

Reads steering/<plugin>/evals/trigger.json:
    {"skill": "<name>", "should": ["prompt", ...], "should_not": ["prompt", ...]}
Runs each prompt headless (`claude -p`, two turns, only the Skill tool allowed),
looks for a Skill tool call naming the skill, and prints trigger and
false-trigger rates. Every run is a real model request: start with --runs 1.
Run it under a clean --config-dir: measured here, a config whose always-loaded
rules already cover a skill loads that skill 0 times in 14.

    steering/tools/trigger-eval [--plugins a,b] [--runs N] [--model M] [--jobs J] [--json out.json]

Any skill, not just steering ones: --cases <file|dir> reads the same shape (one object
or a list) from elsewhere, e.g. tools/trigger_cases/. Each skill is found under
--skill-root (default ~/.claude/skills) and linked into the run's own .claude/skills.
Pair it with a clean --config-dir: without one the home config and every skill
installed there load too, and a miss cannot be told from a skill that was never
offered. --streams DIR keeps each run's raw stream so that can be checked.
--max-runs and --max-cost-usd stop starting runs at the cap and mark the result partial.
Each run is pass, miss, error or timeout; rates cover finished runs only.
--dry-run prints the plan and the request count and calls nothing.
"""
import argparse
import concurrent.futures as cf
import json
import math
import os
import shutil
import subprocess
import sys
import tempfile
import threading
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def case_files(paths):
    if not paths:
        return sorted(ROOT.glob("*/evals/trigger.json"))
    out = []
    for p in map(Path, paths):
        out += sorted(p.glob("*.json")) if p.is_dir() else [p]
    return out


def load_cases(only, paths=None):
    cases = []
    for f in case_files(paths):
        doc = json.loads(f.read_text())
        for d in doc if isinstance(doc, list) else [doc]:
            if only and d["skill"] not in only:
                continue
            cases += [(d["skill"], True, q) for q in d.get("should", [])]
            cases += [(d["skill"], False, q) for q in d.get("should_not", [])]
    return cases


def link_skills(skills, roots, cwd):
    """Link each skill dir into <cwd>/.claude/skills; return the names not found."""
    dest = Path(cwd) / ".claude" / "skills"
    dest.mkdir(parents=True, exist_ok=True)
    missing = []
    for s in sorted(skills):
        src = next((Path(r).expanduser() / s for r in roots if (Path(r).expanduser() / s / "SKILL.md").is_file()), None)
        if src is None:
            missing.append(s)
        elif not (dest / s).exists():
            (dest / s).symlink_to(src.resolve(), target_is_directory=True)
    return missing


def skills_called(stream):
    called = set()
    for line in stream.splitlines():
        try:
            o = json.loads(line)
        except ValueError:
            continue
        if o.get("type") != "assistant":
            continue
        for c in o.get("message", {}).get("content") or []:
            if c.get("type") == "tool_use" and c.get("name") == "Skill":
                called.add(str((c.get("input") or {}).get("skill", "")).split(":")[-1])
    return called


def parse_stream(stdout, returncode):
    """Return (status, called, cost). status is "error" when the run produced no usable result."""
    result = None
    for line in stdout.splitlines():
        try:
            o = json.loads(line)
        except ValueError:
            continue
        if o.get("type") == "result":
            result = o
    cost = float((result or {}).get("total_cost_usd") or 0)
    if returncode != 0 or result is None or result.get("is_error"):
        return "error", set(), cost
    return "ok", skills_called(stdout), cost


def run_one(args, prompt, plugin_dirs, cwd, tag=""):
    cmd = [args.claude, "-p", prompt, "--model", args.model, "--max-turns", "2",
           "--output-format", "stream-json", "--verbose", "--allowedTools", "Skill"]
    if args.max_cost_usd:
        cmd += ["--max-budget-usd", str(args.max_cost_usd)]
    for d in plugin_dirs:
        cmd += ["--plugin-dir", str(d)]
    env = dict(os.environ)
    if args.config_dir:
        env["CLAUDE_CONFIG_DIR"] = args.config_dir
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=args.timeout, cwd=cwd,
                           stdin=subprocess.DEVNULL, env=env)
    except subprocess.TimeoutExpired:
        return "timeout", set(), 0.0
    if args.streams:
        Path(args.streams).mkdir(parents=True, exist_ok=True)
        (Path(args.streams) / f"{tag}.jsonl").write_text(p.stdout)
    return parse_stream(p.stdout, p.returncode)


def collect(args, jobs, dirs, cwd):
    """Run jobs under the run and cost caps. Returns (rows, partial); skipped rows never started."""
    lock = threading.Lock()
    state = {"started": 0, "cost": 0.0}

    def go(i, skill, want, q, r):
        with lock:
            if (args.max_runs and state["started"] >= args.max_runs) or \
               (args.max_cost_usd and state["cost"] >= args.max_cost_usd):
                return "skipped", set(), 0.0
            state["started"] += 1
        status, called, cost = run_one(args, q, dirs, cwd, f"{skill}-{'pos' if want else 'neg'}-{i:03d}-r{r}")
        with lock:
            state["cost"] += cost
        return status, called, cost

    rows = []
    with cf.ThreadPoolExecutor(args.jobs) as ex:
        futs = {ex.submit(go, i, *j): j for i, j in enumerate(jobs)}
        for fut in cf.as_completed(futs):
            skill, want, q, _ = futs[fut]
            status, called, cost = fut.result()
            hit = skill in called if status == "ok" else None
            if status == "ok":
                status = "pass" if hit == want else "miss"
            rows.append({"skill": skill, "should": want, "prompt": q, "status": status, "hit": hit,
                         "called": sorted(called) if hit is not None else None, "cost_usd": cost})
            print({"pass": ".", "miss": ".", "error": "E", "timeout": "T", "skipped": "-"}[status],
                  end="", file=sys.stderr, flush=True)
    return rows, any(r["status"] == "skipped" for r in rows)


def tally(rows):
    """Per skill: hits over finished runs only; errors, timeouts and skips are counted apart."""
    out = {}
    for r in rows:
        t = out.setdefault(r["skill"], dict(pos_hit=0, pos_n=0, neg_hit=0, neg_n=0, error=0, timeout=0, skipped=0))
        if r["hit"] is None:
            t[r["status"]] += 1
        else:
            k = "pos" if r["should"] else "neg"
            t[k + "_n"] += 1
            t[k + "_hit"] += r["hit"]
    return out


def _fisher_one_sided(n, k):
    """P(all k hits fall in the first of two n-run arms) when both arms share one hit rate."""
    return math.comb(n, k) / math.comb(2 * n, k)


def min_detectable(n, alpha=0.05):
    """Smallest (hits, baseline_hits, p): k/n vs 0/n with one-sided Fisher p < alpha; None if no k works."""
    for k in range(1, n + 1):
        p = _fisher_one_sided(n, k)
        if p < alpha:
            return k, 0, p
    return None


def resolution(n, alpha=0.05):
    m = min_detectable(n, alpha)
    if m is None:
        return (f"resolution: with --runs {n}, one case cannot reach p<{alpha} "
                f"(even {n}/{n} vs 0/{n} gives p={_fisher_one_sided(n, n):.3f}); pool cases or raise --runs")
    k, b, p = m
    return (f"resolution: with --runs {n}, one case reaches p<{alpha} only at {k}/{n} vs {b}/{n} "
            f"(p={p:.3f}); smaller gaps are noise")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--plugins", default="", help="comma list of skill names; default all with evals")
    ap.add_argument("--runs", type=int, default=1)
    ap.add_argument("--model", default="sonnet")
    ap.add_argument("--jobs", type=int, default=4)
    ap.add_argument("--timeout", type=int, default=180)
    ap.add_argument("--claude", default=os.environ.get("CLAUDE_BIN") or shutil.which("claude") or "claude")
    ap.add_argument("--no-plugin-dir", action="store_true", help="skills are already installed; do not pass --plugin-dir")
    ap.add_argument("--config-dir", help="CLAUDE_CONFIG_DIR to run under. Use a clean one (credentials only): "
                    "a home config that already states these rules hides whether the skill loads")
    ap.add_argument("--json", dest="out")
    ap.add_argument("--cases", action="append", help="case file or dir (repeatable); default: steering plugin evals")
    ap.add_argument("--skill-root", action="append", help="where --cases skills live (repeatable; default ~/.claude/skills)")
    ap.add_argument("--limit", type=int, default=0, help="run only the first N prompts (a smoke run)")
    ap.add_argument("--max-runs", type=int, default=0, help="start at most N runs, then stop and mark the result partial")
    ap.add_argument("--max-cost-usd", type=float, default=0.0, help="stop starting runs once reported spend reaches this; "
                    "also passed to each call as --max-budget-usd")
    ap.add_argument("--dry-run", action="store_true", help="print the plan and request count; call nothing")
    ap.add_argument("--streams", help="dir to keep each run's raw stream-json in")
    args = ap.parse_args()
    only = {s for s in args.plugins.split(",") if s}
    cases = load_cases(only, args.cases)
    if not cases:
        sys.exit("no cases found")
    if args.limit:
        cases = cases[: args.limit]
    cwd = tempfile.mkdtemp(prefix="trigger-eval-")
    if args.cases:
        dirs = []
        missing = link_skills({s for s, _, _ in cases}, args.skill_root or ["~/.claude/skills"], cwd)
        if missing:
            sys.exit(f"skill dir not found under --skill-root: {', '.join(missing)}")
    else:
        dirs = [] if args.no_plugin_dir else [f.parents[1] for f in sorted(ROOT.glob("*/evals/trigger.json"))]
    jobs = [(skill, want, q, r) for skill, want, q in cases for r in range(args.runs)]
    if args.dry_run:
        for skill in sorted({s for s, _, _ in cases}):
            pos = sum(1 for s, w, _ in cases if s == skill and w)
            neg = sum(1 for s, w, _ in cases if s == skill and not w)
            print(f"{skill:24} should={pos} should_not={neg}")
        print(f"requests: {len(jobs)} ({len(cases)} prompts x {args.runs} runs, up to 2 turns each), "
              f"model {args.model}, cwd {cwd}")
        print(resolution(args.runs))
        return
    rows, partial = collect(args, jobs, dirs, cwd)
    print(file=sys.stderr)
    print(f"{'skill':24} trigger        false-trigger  errors  timeouts  skipped")
    rate = lambda h, n: f"{h}/{n}" if n else "-"
    for skill, t in sorted(tally(rows).items()):
        print(f"{skill:24} {rate(t['pos_hit'], t['pos_n']):14} {rate(t['neg_hit'], t['neg_n']):14} "
              f"{t['error']:<7} {t['timeout']:<9} {t['skipped']}")
    print("rates count only runs that finished; errors and timeouts are not misses")
    if partial:
        print(f"PARTIAL: stopped at the cap ({args.max_runs or '-'} runs, ${args.max_cost_usd or '-'}); "
              f"{sum(r['status'] == 'skipped' for r in rows)} of {len(rows)} runs never started")
    print(f"cost: ${sum(r['cost_usd'] for r in rows):.2f}")
    print(resolution(args.runs))
    for r in sorted(rows, key=lambda r: (r["skill"], r["should"])):
        if r["status"] == "miss":
            print(f"  MISS {r['skill']} ({'should' if r['should'] else 'should not'}; called {r['called']}): {r['prompt'][:90]}")
    if args.out:
        Path(args.out).write_text(json.dumps({"partial": partial, "rows": rows}, indent=1))


if __name__ == "__main__":
    main()
