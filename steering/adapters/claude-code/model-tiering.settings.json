{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/model-tiering/hooks/dispatch-model-guard\"",
            "timeout": 5
          }
        ],
        "matcher": "Agent|Task"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/model-tiering/hooks/cue\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
