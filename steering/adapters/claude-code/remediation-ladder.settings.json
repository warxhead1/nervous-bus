{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/remediation-ladder/hooks/bypass-guard\"",
            "timeout": 5
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/remediation-ladder/hooks/cue\"",
            "timeout": 5
          }
        ],
        "matcher": "Bash|Write|Edit|MultiEdit"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/remediation-ladder/hooks/cue\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
