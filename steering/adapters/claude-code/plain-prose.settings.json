{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/plain-prose/hooks/prose-guard\"",
            "timeout": 10
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/plain-prose/hooks/prose-guard\"",
            "timeout": 10
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/plain-prose/hooks/reply-score\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/plain-prose/hooks/cue\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
