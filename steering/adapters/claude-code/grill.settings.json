{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/grill/hooks/ledgered-ask-guard\"",
            "timeout": 5
          }
        ],
        "matcher": "Bash"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/grill/hooks/cue\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
