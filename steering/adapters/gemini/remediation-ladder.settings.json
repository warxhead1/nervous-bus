{
  "hooks": {
    "BeforeTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/adapters/shim\" --harness gemini --event PreToolUse \"$STEERING_HOME/remediation-ladder/hooks/bypass-guard\"",
            "timeout": 5
          }
        ],
        "matcher": "run_shell_command"
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/adapters/shim\" --harness gemini --event PostToolUse \"$STEERING_HOME/remediation-ladder/hooks/cue\"",
            "timeout": 5
          }
        ],
        "matcher": "run_shell_command|write_file|replace"
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/adapters/shim\" --harness gemini --event UserPromptSubmit \"$STEERING_HOME/remediation-ladder/hooks/cue\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
