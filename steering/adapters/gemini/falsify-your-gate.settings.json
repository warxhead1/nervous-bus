{
  "hooks": {
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/adapters/shim\" --harness gemini --event PostToolUse \"$STEERING_HOME/falsify-your-gate/hooks/vacuous-test-guard\"",
            "timeout": 8
          }
        ],
        "matcher": "write_file|replace"
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/adapters/shim\" --harness gemini --event UserPromptSubmit \"$STEERING_HOME/falsify-your-gate/hooks/cue\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
