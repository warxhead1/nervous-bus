{
  "version": "v1",
  "hooks": [
    {
      "name": "remediation-ladder-bypass-guard-PreToolUse",
      "trigger": "PreToolUse",
      "action": {
        "type": "command",
        "command": "python3 \"$STEERING_HOME/adapters/shim\" --harness kiro --event PreToolUse \"$STEERING_HOME/remediation-ladder/hooks/bypass-guard\""
      },
      "timeout": 5,
      "enabled": true,
      "matcher": "shell"
    },
    {
      "name": "remediation-ladder-cue-UserPromptSubmit",
      "trigger": "UserPromptSubmit",
      "action": {
        "type": "command",
        "command": "python3 \"$STEERING_HOME/adapters/shim\" --harness kiro --event UserPromptSubmit \"$STEERING_HOME/remediation-ladder/hooks/cue\""
      },
      "timeout": 5,
      "enabled": true
    }
  ]
}
