{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/adapters/shim\" --harness codex --event PostToolUse \"$STEERING_HOME/evidence-before-done/hooks/unfinished-guard\"",
            "timeout": 10
          }
        ],
        "matcher": "apply_patch"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/adapters/shim\" --harness codex --event UserPromptSubmit \"$STEERING_HOME/evidence-before-done/hooks/cue\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/adapters/shim\" --harness codex --event Stop \"$STEERING_HOME/evidence-before-done/hooks/visual-proof-guard\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
