{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/adapters/shim\" --harness codex --event PreToolUse \"$STEERING_HOME/isolated-dispatch/hooks/dispatch-isolation-guard\"",
            "timeout": 5
          }
        ],
        "matcher": "spawn_agent"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/adapters/shim\" --harness codex --event PreToolUse \"$STEERING_HOME/isolated-dispatch/hooks/stash-guard\"",
            "timeout": 5
          }
        ],
        "matcher": "Bash"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$STEERING_HOME/adapters/shim\" --harness codex --event UserPromptSubmit \"$STEERING_HOME/isolated-dispatch/hooks/cue\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
