#!/usr/bin/env python3
"""PreToolUse hook (Bash): no anonymous stash, no pop.

The stash stack is shared by every worktree of a repository. A bare
`git stash` takes every tracked change in the checkout, including another
session's; `pop` takes the top entry, whoever pushed it. Exit 2 blocks them.
Allowed: `stash push -m <tag>`, `list`, `show`, `apply`, `create`, `store`,
`branch`, and `pop`/`drop` that name an entry. Kill switch: STASH_GUARD_DISABLE=1.
"""
import json
import os
import re
import sys

QUOTED = re.compile(r"'[^']*'|\"(?:\\.|[^\"\\])*\"")
HEREDOC = re.compile(r"<<-?\s*(['\"]?)(\w+)\1[^\n]*\n.*?^\s*\2\s*$", re.S | re.M)
STASH = re.compile(r"\bgit\b(?:\s+-[cC]\s+\S+|\s+--\S+)*\s+stash\b([^;&|\n]*)")
SAFE = {"list", "show", "apply", "create", "store", "branch"}


def blocked(command):
    for m in STASH.finditer(QUOTED.sub("''", HEREDOC.sub("", command))):
        args = m.group(1).split()
        sub = next((a for a in args if not a.startswith("-")), "push")
        if sub in SAFE:
            continue
        if sub in ("push", "save", "''") and any(a in ("-m", "--message") or a.startswith("--message=") for a in args):
            continue
        if sub in ("pop", "drop") and len([a for a in args if not a.startswith("-")]) > 1:
            continue  # names the entry it acts on
        return "pop" if sub in ("pop", "drop", "clear") else "bare"
    return None


def main():
    if os.environ.get("STASH_GUARD_DISABLE") == "1":
        return 0
    try:
        ev = json.load(sys.stdin)
        command = (ev.get("tool_input") or {}).get("command") or ""
    except Exception:
        return 0
    if ev.get("tool_name") != "Bash" or not isinstance(command, str):
        return 0
    kind = blocked(command)
    if kind == "bare":
        print(
            "A bare `git stash` takes every tracked change in this checkout, and the stash stack is shared "
            "across worktrees. Changes you did not make are someone's work: read them with `git diff` first. "
            "To set your own work aside, commit it as WIP on a branch, or `git stash push -m <unique-tag> -- <paths>`.",
            file=sys.stderr,
        )
        return 2
    if kind == "pop":
        print(
            "A `git stash pop` or `drop` with no entry named takes the top one, and `clear` takes all; they may belong "
            "to another session. Find yours with `git stash list` and name it: `git stash apply <ref>`.",
            file=sys.stderr,
        )
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
