#!/usr/bin/env python3
"""Report heavy prose where it is written: a document, a commit message, a pull request.

Runs the ste80-humanizer checker and keeps the findings a careful writer rarely
makes on purpose: AI tells, sentences that carry too much, semicolons and
dashes used as sentence glue.

PostToolUse (Write|Edit|MultiEdit): scores the lines the edit ADDED to a
document. Text that was already in the file is never blamed on the edit. The
write stands. A file is reported at most twice a session.

PreToolUse (Bash): scores the message of a `git commit` and the body of a
`gh pr` or `gh issue` command, before it runs. History cannot be rewritten
after a push, so this is the one moment the text can still change. The command
is sent back once. The next such command runs without a check, so the same
text, or a rewrite, always goes through.

Exit 2 puts stderr in front of the agent. Kill switch: PLAIN_PROSE_DISABLE=1.
"""
import importlib.util
import json
import os
import re
import sys
from collections import Counter
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from steering_hits import log_hit  # the plugin's own writer, next to this file

PROSE = {".md", ".mdx", ".txt", ".rst"}
NOT_OURS = re.compile(r"^(LICEN[CS]E|NOTICE|COPYING|THIRD_PARTY|CHANGELOG)", re.I)
VENDORED = {"node_modules", "vendor", "third_party", ".git"}
NOTES = {"scratch", "tmp"}                   # working notes, when the file sits one or two levels inside
# Checker rules that are tells on one sighting.
TELLS = {"not-x-but-y", "chatbot", "run-up", "fake-depth", "closer", "strawman", "knowledge-hedge",
         "meta", "stacked-hedge", "vague-authority", "ing-rider", "inflation"}
# Words from the checker's swap list that nobody needs; the rest ("verify", "via") are ordinary.
STOCK = {"utilize", "utilise", "delve", "seamless", "seamlessly", "pivotal", "tapestry", "testament",
         "game-changer", "showcase", "groundbreaking", "cutting-edge", "world-class", "best-in-class",
         "stunning", "breathtaking", "it is important to note", "it's important to note",
         "it should be noted", "in order to", "serves as", "stands as", "boasts"}
LONG, VERY_LONG = 30, 45                     # words in one sentence
KINDS = ("tell", "very_long", "long", "semicolon", "dash")
# A tell reports on one sighting. The rest add up to a load: a long sentence and a semicolon
# count 1 each, a very long sentence 2, a dash a half. Report at LOAD or more, when that is also
# PER_100 or more per 100 added words, so a long document with a few of them stays quiet.
LOAD, PER_100 = 4, 1.0
QUOTED = re.compile(r'"[^"\n]{1,200}"|“[^”\n]{1,200}”')    # someone else's words, or a phrase under discussion
REPORTS_PER_FILE = 2
FENCE = re.compile(r"^\s*(```|~~~)|^---\s*$")
GLUE = re.compile(r"\s(?:—|--)\s")
WRITES_A_MESSAGE = re.compile(r"\bgit\b[^\n|;&]*\bcommit\b|\bgh\s+(?:pr|issue)\s+(?:create|edit|comment|review)\b")
HEREDOC = re.compile(r"<<-?\s*(['\"]?)(\w+)\1[^\n]*\n(.*?)\n[ \t]*\2\b", re.S)
INLINE = re.compile(r"""(?:\s-[a-zA-Z]*m|\s--message|\s--body|\s-b)[=\s]\s*(?:"((?:[^"\\]|\\.)*)"|'([^']*)')""", re.S)
FROM_FILE = re.compile(r"(?:\s-F|\s--file|\s--body-file)[=\s]\s*([^\s'\"<|;&]+)")
MID_SEMI = re.compile(r"[a-z)],?;\s+\w")     # joins two clauses; not the end of a list item, not code


def load_checker():
    path = Path(__file__).resolve().parents[1] / "skills" / "ste80-humanizer" / "scripts" / "ste_check.py"
    spec = importlib.util.spec_from_file_location("ste_check", path)
    mod = importlib.util.module_from_spec(spec)
    sys.modules["ste_check"] = mod           # its dataclass looks itself up here
    spec.loader.exec_module(mod)
    return mod


def added_lines(ev, src):
    """1-based numbers of the lines this tool call added, or None for the whole file."""
    patch = (ev.get("tool_response") or {}).get("structuredPatch") if isinstance(ev.get("tool_response"), dict) else None
    if patch:
        out = set()
        for hunk in patch:
            n = hunk.get("newStart", 1)
            for line in hunk.get("lines", []):
                if line.startswith("+"):
                    out.add(n)
                if not line.startswith("-"):
                    n += 1
        return out
    tool, ti = ev.get("tool_name"), ev.get("tool_input", {})
    if tool == "Write":
        return None
    out, lines = set(), src.splitlines()
    for e in ti.get("edits") or [ti]:
        new, old = e.get("new_string", ""), set(e.get("old_string", "").splitlines())
        at = src.find(new) if new else -1
        if at < 0:
            continue
        first = src.count("\n", 0, at) + 1
        for n in range(first, first + new.count("\n") + 1):
            if n <= len(lines) and lines[n - 1] not in old:
                out.add(n)
    return out


def glue_dash(raw):
    """A dash that joins two clauses, not one that follows a label or sits in a heading."""
    if raw.lstrip().startswith("#"):
        return False
    return any(len(a.split()) >= 4 and len(b.split()) >= 4
               for a, b in zip(GLUE.split(raw), GLUE.split(raw)[1:]))


def score(mod, src, added=None):
    """Findings on the added lines of src: ({kind: [(line, note, excerpt)], "rules": Counter, "stats": {...}}, words added)."""
    raw = src.splitlines()
    if added is not None:                    # blank what the edit did not add; keep fences so code stays code
        src = "\n".join(l if n in added or FENCE.match(l) else "" for n, l in enumerate(raw, 1))
    src = QUOTED.sub("QUOTE", src)           # the checker counts a quote as one word too
    src = "\n".join("" if l.lstrip().startswith(">") else l for l in src.split("\n"))   # a block quote is a quote
    out = {k: [] for k in KINDS}
    rules = out["rules"] = Counter()
    for f in mod.check(src, False):
        if f.rule in TELLS:
            out["tell"].append((f.line, f.message.split(":")[0], f.excerpt))
            rules[f.rule] += 1
        elif f.rule == "word" and f.message.split("'")[1] in STOCK:
            out["tell"].append((f.line, f.message, f.excerpt))
            rules["word"] += 1
        elif f.rule == "sentence-length":
            n = int(f.message.split()[0])
            if n > LONG:
                out["very_long" if n > VERY_LONG else "long"].append((f.line, f"{n} words", f.excerpt))
                rules["sentence-length"] += 1
        elif f.rule == "semicolon":              # the checker reports a line once; count each join in it
            joins = len(MID_SEMI.findall(raw[f.line - 1]))
            out["semicolon"] += [(f.line, "semicolon", f.excerpt)] * joins
            rules["semicolon"] += joins
        elif f.rule == "dash" and glue_dash(raw[f.line - 1]):
            out["dash"].append((f.line, "dash", f.excerpt))
            rules["dash"] += 1
    words = sum(len(p.split()) for _, p in mod.paragraphs(mod.strip_markdown(src)))
    out["stats"] = stats_of(mod, src, words)
    return out, words


def stats_of(mod, text, words=None):
    s = mod.summary(text)
    if words is None:
        words = sum(len(p.split()) for _, p in mod.paragraphs(mod.strip_markdown(text)))
    return {"words": words, "avg_sentence": s["avg_words_per_sentence"], "max_sentence": s["max_words_per_sentence"]}


def fires(found, words):
    load = len(found["long"]) + 2 * len(found["very_long"]) + len(found["semicolon"]) + len(found["dash"]) / 2
    return bool(found["tell"]) or (load >= LOAD and 100 * load >= PER_100 * max(words, 1))


def state_file(ev):
    base = os.environ.get("XDG_CACHE_HOME")
    return (Path(base) if base else Path.home() / ".cache") / "plain-prose-guard" / f"{ev.get('session_id', 'nosession')}.json"


def message_text(command, cwd):
    """The prose a commit or a gh command is about to publish, or "" when there is none to read."""
    if not WRITES_A_MESSAGE.search(command):
        return ""
    parts = []
    for m in HEREDOC.finditer(command):
        opener = command[command.rfind("\n", 0, m.start()) + 1:m.start()]
        if WRITES_A_MESSAGE.search(opener):          # a heredoc that feeds some other command is not the message
            parts.append(m.group(3))
    for m in INLINE.finditer(HEREDOC.sub(" ", command)):
        text = m.group(1) if m.group(1) is not None else m.group(2)
        if "$(" not in text:
            parts.append(text.replace("\\n", "\n"))
    for m in FROM_FILE.finditer(command):
        try:
            f = Path(cwd or ".") / m.group(1)
            if m.group(1) != "-" and f.is_file() and f.stat().st_size < 100_000:
                parts.append(f.read_text(encoding="utf-8", errors="replace"))
        except Exception:
            pass
    return "\n\n".join(parts).replace("\\`", "`").replace('\\"', '"').replace("\\$", "$")   # undo shell escapes


def read_state(ev):
    try:
        return json.loads(state_file(ev).read_text())
    except Exception:
        return {}


def write_state(ev, seen):
    try:
        state_file(ev).parent.mkdir(parents=True, exist_ok=True)
        state_file(ev).write_text(json.dumps(seen))
    except Exception:
        pass


def report(where, found, advice):
    try:
        sys.stderr.reconfigure(encoding="utf-8", errors="replace")   # a console that is not UTF-8 must not break the report
    except Exception:
        pass
    long = found["very_long"] + found["long"]
    parts = [f"{len(v)} {name}" for name, v in (("AI tell(s)", found["tell"]), (f"sentence(s) over {LONG} words", long),
                                                 ("semicolon(s)", found["semicolon"]), ("dash(es) joining clauses", found["dash"])) if v]
    print(f"plain-prose {where} {', '.join(parts)}.", file=sys.stderr)
    worst = found["tell"] + sorted(long, key=lambda x: -int(x[1].split()[0])) + found["semicolon"] + found["dash"]
    for line, note, excerpt in list(dict.fromkeys(worst))[:6]:          # a line with two semicolons is shown once
        print(f"  line {line} ({note}): {excerpt[:90]}", file=sys.stderr)
    print(
        "One idea per sentence. Split at the semicolon, the dash or the second \"and\", and name who acts. "
        f"Keep every fact, number and name. {advice} Method: ste80-humanizer skill.",
        file=sys.stderr,
    )
    return 2


LOST = {"fidelity-number": "numbers", "fidelity-url": "urls", "fidelity-quote": "quotes", "fidelity-certainty": "hedges"}
LOST_NAMES = {"numbers": "number(s)", "urls": "URL(s)", "code": "code span(s)", "flags": "CLI flag(s)",
              "quotes": "quote(s)", "hedges": "hedge(s)"}
REWRITE_MIN_WORDS = 6                        # an edit of a shorter span is a value change, not a rewrite
CODE_TOKEN = re.compile(r"code `(.*?)` from")


def lost_kind(finding):
    if finding.rule in LOST:
        return LOST[finding.rule]
    m = CODE_TOKEN.match(finding.message)
    return "flags" if m and m.group(1).startswith("-") else "code"


def rel(path, ev):
    try:
        return str(path.resolve().relative_to(Path(ev.get("cwd") or os.getcwd()).resolve()))
    except Exception:
        return str(path)


def compare_pairs(pairs, ev, surface, shown):
    """Compare (old, new) text pairs, log a prose-compare record (a clean pass too), return (findings, lost counts)."""
    mod = load_checker()
    findings = [f for o, n in pairs for f in mod.compare_texts(o, n)]
    lost = Counter(lost_kind(f) for f in findings)
    stats = stats_of(mod, "\n\n".join(n for _, n in pairs))
    log_hit("prose-compare", surface, ev, "report" if findings else "none", len(findings), Counter(f.rule for f in findings), shown,
            stats, {k: lost.get(k, 0) for k in LOST_NAMES})
    return findings, lost


def rewrite_check(ev, path):
    """Report what an Edit or MultiEdit took out of existing prose. Pure additions and short value edits are skipped."""
    try:
        ti = ev.get("tool_input", {})
        if ev.get("tool_name") not in ("Edit", "MultiEdit"):
            return 0
        pairs = [(e.get("old_string", ""), e.get("new_string", "")) for e in (ti.get("edits") or [ti])]
        pairs = [(o, n) for o, n in pairs if len(o.split()) >= REWRITE_MIN_WORDS and n.strip() and o.strip() not in n]
        if not pairs:
            return 0
        findings, lost = compare_pairs(pairs, ev, "doc", rel(path, ev))
        if not findings:
            return 0
    except Exception:
        return 0
    try:
        sys.stderr.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass
    parts = ", ".join(f"{lost[k]} {LOST_NAMES[k]}" for k in LOST_NAMES if lost.get(k))
    print(f"plain-prose {path.name}: this rewrite lost {len(findings)} fact(s) the old text had: {parts}.", file=sys.stderr)
    for f in findings[:6]:
        print(f"  {f.message}", file=sys.stderr)
    print("Put each one back, or leave it out if the cut was on purpose. The write stands. Method: ste80-humanizer skill.",
          file=sys.stderr)
    return 2


def added_check(ev, path, src):
    try:
        added = added_lines(ev, src)
        if added is not None and not added:
            return 0
        found, words = score(load_checker(), src, added)
    except Exception:
        return 0
    if not fires(found, words):
        return 0
    seen = read_state(ev)
    if seen.get(str(path), 0) >= REPORTS_PER_FILE:
        return 0
    seen[str(path)] = seen.get(str(path), 0) + 1
    write_state(ev, seen)
    log_hit("prose-guard", "doc", ev, "report", sum(len(found[k]) for k in KINDS), found["rules"], rel(path, ev), found["stats"])
    return report(f"{path.name}: this edit added", found,
                  "Leave it if it is a quote, a list of data, or text the reader asked for in this form.")


def document(ev):
    try:
        path = Path(ev["tool_input"]["file_path"])
        if (path.suffix.lower() not in PROSE or NOT_OURS.match(path.name) or VENDORED & set(path.parts) or NOTES & {p.name for p in list(path.parents)[:2]}
                or not path.is_file() or path.stat().st_size > 400_000):
            return 0
        src = path.read_text(encoding="utf-8", errors="replace")
    except Exception:
        return 0
    first = rewrite_check(ev, path)
    return max(first, added_check(ev, path, src))


def message(ev):
    try:
        text = message_text(ev["tool_input"]["command"], ev.get("cwd"))
        if not text.strip():
            return 0
    except Exception:
        return 0
    seen = read_state(ev)
    if seen.pop("message sent back", False):          # the try after a report always runs
        write_state(ev, seen)
        return 0
    try:
        found, words = score(load_checker(), text)
    except Exception:
        return 0
    if not fires(found, words):
        return 0
    seen["message sent back"] = True
    write_state(ev, seen)
    command = ev["tool_input"]["command"]
    surface = "pr" if re.search(r"\bgh\s+pr\b", command) else "issue" if re.search(r"\bgh\s+issue\b", command) else "commit"
    log_hit("prose-guard", surface, ev, "block", sum(len(found[k]) for k in KINDS), found["rules"], "", found["stats"])
    return report("message: the text this command publishes has", found,
                  "The command did not run. Rewrite the text and run it again. "
                  "To publish it as it is, run the same command again.")


USAGE = """usage:
  prose-guard check [--surface doc|commit|pr|issue|reply] [--compare ORIGINAL] [--session ID] [--cwd DIR] [--json] [FILE|-]
  prose-guard score [--session ID] [--cwd DIR] [--json] [FILE|-]
  prose-guard            (Claude Code hook: reads the hook event on stdin)

check  scores the text for AI tells and heavy sentences. With --compare it also reports the facts
       (numbers, code, flags, URLs, quotes, hedges) that ORIGINAL had and the text lost.
       Exit 0 clean, 1 report (findings, nothing to stop), 2 block (a heavy commit, pr or issue text), 64 unreadable input.
score  logs and prints words, average and maximum sentence length and rule counts for a reply. Exit 0.
Both append hit records to $AGENT_STEERING_HITS (off: AGENT_STEERING_LOG=0). Methods: ste80-humanizer skill.
"""


def read_arg(name):
    if name in (None, "-"):
        return sys.stdin.read()
    return Path(name).read_text(encoding="utf-8", errors="replace")


def cli(argv):
    import argparse
    import contextlib
    ap = argparse.ArgumentParser(prog="prose-guard", usage=USAGE, add_help=False)
    ap.add_argument("command", choices=("check", "score"))
    ap.add_argument("file", nargs="?")
    ap.add_argument("--surface", default=None, choices=("doc", "commit", "pr", "issue", "reply"))
    ap.add_argument("--compare", metavar="ORIGINAL")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--session", default="", help="session id for the hit record")
    ap.add_argument("--cwd", default=None, help="working directory for the hit record (default: the current one)")
    ap.add_argument("-h", "--help", action="store_true")
    a = ap.parse_intermixed_args(argv)
    if a.help:
        print(USAGE)
        return 0
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
        text = read_arg(a.file)
        original = read_arg(a.compare) if a.compare else None
    except OSError as exc:
        print(f"prose-guard: {exc}", file=sys.stderr)
        return 64
    ev = {"cwd": a.cwd or os.getcwd(), "session_id": a.session}
    if a.command == "score":
        from prose_score import score_reply
        result = score_reply(text, ev, "reply") or {"words": 0, "avg_sentence": 0, "max_sentence": 0, "findings": 0, "rules": {}}
        if a.json:
            print(json.dumps(result))
        else:
            print(f"words {result['words']}, average sentence {result['avg_sentence']}, longest {result['max_sentence']}, "
                  f"{result['findings']} finding(s)")
            for rule, n in sorted(result["rules"].items(), key=lambda x: -x[1]):
                print(f"  {rule}: {n}")
        return 0
    surface = a.surface or "doc"
    if surface == "reply":
        from prose_score import prose_of
        text = prose_of(text)
    mod = load_checker()
    found, words = score(mod, text)
    fired = fires(found, words)
    shown = a.file if a.file not in (None, "-") else ""
    block = fired and surface in ("commit", "pr", "issue")
    if fired:
        log_hit("prose-guard", surface, ev, "block" if block else "report", sum(len(found[k]) for k in KINDS), found["rules"], shown,
                found["stats"])
    lost, compared = Counter(), []
    if original is not None:
        compared, lost = compare_pairs([(original, text)], ev, surface, shown)
    if a.json:
        print(json.dumps({
            "surface": surface, "action": "block" if block else "report" if fired or compared else "none", "fires": fired,
            "findings": {k: [{"line": l, "note": n, "excerpt": e} for l, n, e in found[k]] for k in KINDS},
            "rules": dict(found["rules"]), **found["stats"],
            "compare": None if original is None else {"lost": {k: lost.get(k, 0) for k in LOST_NAMES},
                                                      "findings": [{"line": f.line, "rule": f.rule, "message": f.message} for f in compared]}}))
    else:
        if fired:
            with contextlib.redirect_stderr(sys.stdout):
                report(f"{shown or 'text'}: this text has", found, "Leave it if it is a quote, a list of data, or text the reader asked for in this form.")
        if compared:
            print(f"plain-prose {shown or 'text'}: the rewrite lost {len(compared)} fact(s) the original had.")
            for f in compared[:6]:
                print(f"  {f.message}")
        if not fired and not compared:
            print("clean")
    if block:
        return 2
    return 1 if fired or compared else 0


def main():
    if len(sys.argv) > 1:
        if sys.argv[1] in ("-h", "--help"):
            print(USAGE)
            return 0
        return cli(sys.argv[1:])
    if os.environ.get("PLAIN_PROSE_DISABLE") == "1":
        return 0
    try:
        ev = json.load(sys.stdin)
        bash = ev.get("tool_name") == "Bash"
        if bash and ev.get("hook_event_name") != "PreToolUse":
            return 0
    except Exception:
        return 0
    return message(ev) if bash else document(ev)


if __name__ == "__main__":
    sys.exit(main())
