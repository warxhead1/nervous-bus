#!/usr/bin/env python3
"""ub-gate: pinned, network-sandboxed runner for unclebob's crapper, dryer, and mutator.

  ub-gate install              fetch the pinned tools and parser grammars (the only networked step)
  ub-gate doctor               JSON: install state, pins, and whether the sandbox works here
  ub-gate crap   [crapper args]   CRAP per function          -> .metrics/crap.edn
  ub-gate crap-go DIR... [-- crapper args]   cover DIR/... with go test, then score DIR with it
  ub-gate dry    [dryer args]     structural duplicates      -> .metrics/dry.edn
                 --since REF      only forms in files changed since REF
                 --against-repo   compare those forms with the whole project
  ub-gate mutate [mutator args]   mutation testing           -> .metrics/mutate/*.edn
  ub-gate mutate-go FILE.go... [-- mutator args]   cover only those files' packages, then mutate
  ub-gate summary              JSON digest of .metrics in the current directory
  ub-gate sandbox -- CMD...    run any command with no network (loopback only)

Every analysis runs with no network: a private network namespace (Linux
`unshare --map-current-user --net`) with only loopback up, plus offline
settings for pip, npm, cargo, and Go. Where the namespace is unavailable the
run stops; UB_GATE_NETWORK=allow runs it with the offline settings alone.

Home: $UB_GATE_HOME, else $XDG_DATA_HOME/ub-gate, else ~/.local/share/ub-gate.
"""

from __future__ import annotations

import hashlib
import json
import os
import platform
import re
import shutil
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
PINS = json.loads((ROOT / "lock" / "pins.json").read_text())
LOCK = ROOT / "lock" / "requirements.lock"
TOOLS = ("crapper", "dryer", "mutator")

OFFLINE_ENV = {
    "GOPROXY": "off",
    "PIP_NO_INDEX": "1",
    "npm_config_offline": "true",
    "CARGO_NET_OFFLINE": "true",
}

# Run inside the namespace with the capabilities --keep-caps granted: bring
# loopback up (tests bind 127.0.0.1), clear the ambient capabilities so the
# tool itself runs with none, then exec it.
LO_UP = r"""
import ctypes, fcntl, os, socket, struct, sys
try:
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    flags = struct.unpack("16sH", fcntl.ioctl(s, 0x8913, struct.pack("16sH", b"lo", 0))[:18])[1]
    fcntl.ioctl(s, 0x8914, struct.pack("16sH", b"lo", flags | 1))
except OSError as exc:
    print(f"ub-gate: loopback stayed down ({exc}); tests that bind 127.0.0.1 will fail", file=sys.stderr)
if ctypes.CDLL(None, use_errno=True).prctl(47, 4, 0, 0, 0) != 0:  # PR_CAP_AMBIENT_CLEAR_ALL
    sys.exit("ub-gate: could not drop capabilities; refusing to run")
os.execvp(sys.argv[1], sys.argv[1:])
"""


def home() -> Path:
    if os.environ.get("UB_GATE_HOME"):
        return Path(os.environ["UB_GATE_HOME"])
    base = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local" / "share")
    return Path(base) / "ub-gate"


def pin_id() -> str:
    digest = hashlib.sha256(LOCK.read_bytes() + json.dumps(PINS, sort_keys=True).encode()).hexdigest()
    return digest[:12]


def venv() -> Path:
    return home() / f"venv-{pin_id()}"


def vpy() -> Path:
    return venv() / ("Scripts/python.exe" if os.name == "nt" else "bin/python")


def ready_marker() -> Path:
    return venv() / "ub-gate-ready.json"


def die(message: str, code: int = 1):
    print(f"ub-gate: {message}", file=sys.stderr)
    sys.exit(code)


def platform_key() -> str:
    system = {"Linux": "linux", "Darwin": "macos", "Windows": "windows"}.get(platform.system(), "")
    machine = platform.machine().lower()
    arch = {"amd64": "x86_64", "x86_64": "x86_64", "arm64": "arm64" if system == "macos" else "aarch64",
            "aarch64": "aarch64" if system != "macos" else "arm64"}.get(machine, machine)
    return f"{system}-{arch}"


def find_python() -> str:
    for name in ("python3.13", "python3.12", "python3.11", "python3"):
        exe = shutil.which(name)
        if not exe:
            continue
        out = subprocess.run([exe, "-c", "import sys;print(sys.version_info>=(3,11))"], capture_output=True, text=True)
        if out.stdout.strip() == "True":
            return exe
    die("needs Python 3.11 or newer on PATH")


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def verify_grammars() -> dict:
    """Check the cached parser bundle against the sha256 pinned in this repo."""
    g = PINS["grammars"]
    key = platform_key()
    pinned = g["bundle_sha256"].get(key)
    if not pinned:
        die(f"no pinned parser bundle for platform {key}")
    out = subprocess.run([str(vpy()), "-I", "-c",
                          "import tree_sitter_language_pack as t;print(t.cache_dir())"],
                         capture_output=True, text=True, check=True).stdout.strip()
    version_dir = Path(out).parent
    if version_dir.name != f"v{g['package_version']}":
        die(f"parser cache {version_dir} does not match pinned v{g['package_version']}")
    bundles = list((version_dir / "bundles").glob(f"{key}-*.tar.zst"))
    if len(bundles) != 1:
        die(f"expected one {key} parser bundle under {version_dir / 'bundles'}, found {len(bundles)}")
    actual = sha256(bundles[0])
    if actual != pinned:
        die(f"parser bundle sha256 {actual} != pinned {pinned}; refusing to load it", 5)
    manifest = json.loads((version_dir / "manifest.json").read_text())
    if manifest["platforms"][key]["sha256"] != pinned:
        die("parser manifest disagrees with the pinned sha256; refusing to load it", 5)
    return {"platform": key, "bundle": str(bundles[0]), "sha256": actual}


def cmd_install(_args) -> int:
    target = venv()
    if ready_marker().is_file():
        verify_grammars()
        print(json.dumps({"installed": str(target), "pin": pin_id(), "already": True}))
        return 0
    home().mkdir(parents=True, exist_ok=True)
    if target.exists():
        shutil.rmtree(target)
    subprocess.run([find_python(), "-m", "venv", str(target)], check=True)
    pip = [str(vpy()), "-m", "pip", "--disable-pip-version-check", "-q", "install"]
    subprocess.run(pip + ["--require-hashes", "--no-deps", "-r", str(LOCK)], check=True)
    repo = PINS["tools_repo"]
    for name in TOOLS:
        url = f"git+{repo.format(name=name)}@{PINS['tools'][name]}"
        # No build isolation: the build backend is the hash-locked setuptools,
        # not whatever setuptools the index has today.
        # PIP_NO_INDEX makes any fetch beyond the pinned git commit fail closed.
        subprocess.run(pip + ["--no-deps", "--no-build-isolation", url], check=True,
                       env=dict(os.environ, PIP_NO_INDEX="1"))
    langs = PINS["grammars"]["languages"]
    subprocess.run([str(vpy()), "-I", "-c",
                    f"import tree_sitter_language_pack as t; t.download({langs!r})"], check=True)
    grammars = verify_grammars()
    ready_marker().write_text(json.dumps({"pin": pin_id(), "tools": PINS["tools"], "grammars": grammars}, indent=1))
    print(json.dumps({"installed": str(target), "pin": pin_id(), "grammars": grammars}))
    return 0


def sandbox_works() -> bool:
    if platform.system() != "Linux" or not shutil.which("unshare"):
        return False
    probe = subprocess.run(["unshare", "--map-current-user", "--net", "--keep-caps", "true"], capture_output=True)
    return probe.returncode == 0


def offline_argv(argv: list[str]) -> list[str]:
    if sandbox_works():
        return ["unshare", "--map-current-user", "--net", "--keep-caps", sys.executable, "-I", "-c", LO_UP, *argv]
    if os.environ.get("UB_GATE_NETWORK") == "allow":
        print("ub-gate: no network namespace here; running with offline settings only "
              "(UB_GATE_NETWORK=allow)", file=sys.stderr)
        return argv
    die("cannot cut the network on this host (needs Linux unprivileged user namespaces). "
        "Set UB_GATE_NETWORK=allow to run with offline settings only.", 4)


def run_offline(argv: list[str]) -> int:
    env = dict(os.environ, **OFFLINE_ENV)
    return subprocess.run(offline_argv(argv), env=env).returncode


def need_install():
    if not ready_marker().is_file():
        die("tools are not installed for this pin; run `ub-gate install` first", 3)
    verify_grammars()


def cmd_tool(name: str, args: list[str]) -> int:
    need_install()
    return run_offline([str(vpy()), "-I", "-m", name, *args])


def cmd_dry(args: list[str]) -> int:
    need_install()
    return run_offline([str(vpy()), "-I", str(HERE / "ub_gate_dry.py"), *args])


def _split_passthrough(args: list[str]) -> tuple[list[str], list[str]]:
    """`TARGETS... [-- TOOL ARGS...]`."""
    if "--" in args:
        index = args.index("--")
        return args[:index], args[index + 1 :]
    return args, []


def _go_cover(patterns: list[str]) -> None:
    """Write crapper's Go coverage profile for exactly these package patterns."""
    profile = Path("target/coverage/go/coverage.out")
    profile.parent.mkdir(parents=True, exist_ok=True)
    profile.unlink(missing_ok=True)
    code = run_offline(["go", "test", "-count=1", f"-coverprofile={profile}", *patterns])
    if code != 0:
        print(f"ub-gate: go test exited {code}; code in failing packages reads as uncovered", file=sys.stderr)
    if not profile.is_file():
        die("go test wrote no coverage profile", 2)


def _rel(path: str) -> str:
    return str(Path(path)).removeprefix("./").rstrip("/") or "."


def cmd_crap_go(args: list[str]) -> int:
    dirs, extra = _split_passthrough(args)
    if not dirs:
        die("usage: ub-gate crap-go DIR... [-- crapper args]")
    need_install()
    _go_cover([f"./{_rel(d)}/..." if _rel(d) != "." else "./..." for d in dirs])
    return run_offline([str(vpy()), "-I", "-m", "crapper", "--use-existing-coverage", *extra, *dirs])


def cmd_mutate_go(args: list[str]) -> int:
    files, extra = _split_passthrough(args)
    if not files or not all(f.endswith(".go") for f in files):
        die("usage: ub-gate mutate-go FILE.go... [-- mutator args]")
    need_install()
    _go_cover(sorted({f"./{_rel(str(Path(f).parent))}" for f in files}))
    return run_offline([str(vpy()), "-I", "-m", "mutator", "--use-existing-coverage", *extra, *files])


def _edn_entries(text: str) -> list[dict]:
    out = []
    for block in re.findall(r"\{[^{}]*\}", text):
        item = {}
        for key, value in re.findall(r':([a-z-]+) ("(?:[^"\\]|\\.)*"|[^\s,}]+)', block):
            item[key] = json.loads(value) if value.startswith('"') else (
                None if value == "nil" else float(value) if re.fullmatch(r"-?[\d.]+", value) else value)
        out.append(item)
    return out


def cmd_summary(_args) -> int:
    metrics = Path(".metrics")
    report: dict = {}
    crap = metrics / "crap.edn"
    if crap.is_file():
        rows = [e for e in _edn_entries(crap.read_text()) if "name" in e]
        scored = [e for e in rows if e.get("crap") is not None]
        worst = sorted(scored or rows, key=lambda e: -(e.get("crap") or e.get("complexity") or 0))[:10]
        report["crap"] = {"functions": len(rows), "over_10": sum(1 for e in scored if e["crap"] >= 10),
                          "complexity_over_10": sum(1 for e in rows if (e.get("complexity") or 0) >= 10),
                          "worst": worst}
    dry = metrics / "dry.edn"
    if dry.is_file():
        scores = [float(s) for s in re.findall(r":score ([\d.]+)", dry.read_text())]
        report["dry"] = {"pairs": len(scores), "at_1.0": sum(1 for s in scores if s >= 0.999)}
    mutate = metrics / "mutate"
    if mutate.is_dir():
        totals = {"killed": 0, "survived": 0, "uncovered": 0}
        for f in mutate.rglob("*.edn"):
            for e in _edn_entries(f.read_text()):
                if "id" not in e:  # skip the :outcomes map; only :forms carry counts
                    continue
                for k in totals:
                    totals[k] += int(e.get(k) or 0)
        ran = totals["killed"] + totals["survived"]
        totals["score"] = round(totals["killed"] / ran, 3) if ran else None
        report["mutate"] = totals
    print(json.dumps(report, indent=1))
    return 0


def cmd_doctor(_args) -> int:
    state = {"home": str(home()), "pin": pin_id(), "installed": ready_marker().is_file(),
             "platform": platform_key(), "sandbox": sandbox_works(), "tools": PINS["tools"],
             "grammar_package": PINS["grammars"]["package_version"]}
    print(json.dumps(state, indent=1))
    return 0


def main(argv: list[str]) -> int:
    if not argv or argv[0] in {"-h", "--help", "help"}:
        print(__doc__.strip())
        return 0
    command, args = argv[0], argv[1:]
    if command == "install":
        return cmd_install(args)
    if command == "doctor":
        return cmd_doctor(args)
    if command == "summary":
        return cmd_summary(args)
    if command == "crap":
        return cmd_tool("crapper", args)
    if command == "mutate":
        return cmd_tool("mutator", args)
    if command == "dry":
        return cmd_dry(args)
    if command == "crap-go":
        return cmd_crap_go(args)
    if command == "mutate-go":
        return cmd_mutate_go(args)
    if command == "sandbox":
        if args[:1] == ["--"]:
            args = args[1:]
        if not args:
            die("sandbox needs a command")
        return run_offline(args)
    die(f"unknown command {command!r}; see `ub-gate --help`", 1)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
